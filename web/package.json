{
  "name": "dbtc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:schema": "node scripts/generate-schema-types.mjs",
    "codegen:check": "node scripts/generate-schema-types.mjs --check",
    "typecheck": "npm run codegen:schema && tsc --noEmit",
    "predev": "npm run codegen:schema",
    "dev": "vite",
    "build:pages": "npm run typecheck && vite build --config vite.config.ts",
    "build:bento": "npm run typecheck && vite build --config vite.singlefile.config.ts",
    "build": "npm run build:pages && npm run build:bento",
    "preview": "vite preview",
    "test": "npm run codegen:check && tsc --noEmit && vitest run --typecheck"
  },
  "dependencies": {
    "@allmaps/maplibre": "^1.0.0-beta.44",
    "@arrow-js/core": "^1.0.0-alpha.10",
    "@awesome.me/webawesome": "^3.14.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev65.0",
    "@naivemap/maplibre-gl-echarts-layer": "^0.2.1",
    "apache-arrow": "^17.0.0",
    "codemirror": "^6.0.1",
    "echarts": "^5.6.0",
    "maplibre-gl": "^4.7.1",
    "marked": "^15.0.0",
    "open-props": "^1.7.12",
    "pmtiles": "^4.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.0.0"
  }
}
